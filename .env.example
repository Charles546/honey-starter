# Honeydipper Starter - Environment Variables
# Copy this file to .env and fill in your values.
#
# NOTE: integration toggles (GitHub/Slack/Kubernetes/Vault/AI) are configured
# statically in bootstrap/init.yaml, not here — edit that file to enable or
# disable integrations.

# --- Required: Redis / Valkey ---
# Connection string for the Valkey/Redis instance used by core daemon drivers.
# Default: localhost:6379 (correct for a local daemon in Phase 1). When
# deployed via docker-compose (Phase 2), set this to the valkey service host,
# e.g. valkey:6379.
VALKEY_ADDR=localhost:6379
# VALKEY_PASSWORD=

# --- Reserved: JWT signing key (SAML/OAuth providers, not Phase 1) ---
# Phase 1 authenticates API callers with auth-simple (bcrypt token compare),
# which does NOT consume this variable. It is read only when the API store
# signs/parses JWTs for SAML/OAuth providers (auth-saml etc.), which are
# disabled in the Phase 1 starter. It is retained here as a placeholder for
# the Phase 2 SAML wiring. If you enable SAML, generate a strong value with:
#   openssl rand -base64 32
HD_JWT_SIGNING_KEY=change-me-to-a-random-64-char-string

# --- Optional: Vault ---
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=hvs.example-root-token

# --- Optional: AI (OpenAI-compatible) ---
# OPENAI_API_KEY=sk-your-openai-api-key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen3.5-9b

# --- Optional: UI / API ---
# HD_UI_URL=http://localhost:3000
# HD_API_PORT=9000

# --- Configcheck ---
# CHECK_REMOTE=1

# --- Docker image ---
# Override the honeydipper image used for configcheck (and later deployment).
# HONEYDIPPER_IMAGE=honeydipper/honeydipper:4.0.0-alpha4-53-g897242b
