# Honeydipper Starter - Environment Variables
# Copy this file to .env and fill in your values.
#
# NOTE: integration toggles (GitHub/Slack/Kubernetes/Vault/AI) are configured
# statically in bootstrap/init.yaml, not here — edit that file to enable or
# disable integrations.

# --- Required: Redis / Valkey ---
# Connection string for the Valkey/Redis instance used by core daemon drivers.
# Default: localhost:6379
VALKEY_ADDR=localhost:6379
# VALKEY_PASSWORD=

# --- Required: JWT Signing Key ---
# Used by the API service to sign session tokens. Generate with:
#   openssl rand -base64 32
HD_JWT_SIGNING_KEY=change-me-to-a-random-64-char-string

# --- Optional: Vault ---
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=hvs.example-root-token

# --- Optional: AI (OpenAI-compatible) ---
# OPENAI_API_KEY=sk-your-openai-api-key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen3.5-9b

# --- Optional: UI / API ---
# HD_UI_URL=http://localhost:3000
# HD_API_PORT=9000

# --- Configcheck ---
# CHECK_REMOTE=1
